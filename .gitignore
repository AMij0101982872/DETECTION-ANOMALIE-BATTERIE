# Données : seuls les 20 CSV bruts sont versionnés (via Git LFS, voir .gitattributes).
# Les fichiers dérivés (parquet, dataset fusionné) se régénèrent avec : python main.py
data/processed/*
!data/**/.gitkeep
*.csv
!data/raw/*.csv
*.parquet
*.rar

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env

# Système / éditeur
.DS_Store
Thumbs.db
.vscode/

# Modèles entraînés et suivi MLflow (racine uniquement, pas src/models/)
/models/
mlruns/
/mlartifacts/

# Dataset externe Zhang et al. : les 7 Go de .pkl ne sont jamais versionnés,
# seul le résumé zhang_extraits.parquet (10 Mo, licence CC BY 4.0) l'est.
data/external/*
!data/external/zhang_extraits.parquet
!data/external/LISEZMOI.md
/mlflow.db
